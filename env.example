# ─── Acesso ao painel ────────────────────────────────────────────────
# Senha única do painel administrativo.
ADMIN_PASSWORD=
# Segredo longo e aleatório para assinar a sessão (ex.: openssl rand -hex 32).
SESSION_SECRET=

# ─── Banco de dados (Neon Postgres via Vercel Marketplace) ───────────
DATABASE_URL=

# ─── Armazenamento dos PDFs (Vercel Blob) ────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ─── Aplicativo Meta / Instagram ─────────────────────────────────────
# "Chave secreta do app do Instagram" (Painel Meta > Instagram > Configuração da API).
INSTAGRAM_APP_SECRET=
# Palavra livre, a mesma digitada no campo "Verificar token" do webhook na Meta.
IG_WEBHOOK_VERIFY_TOKEN=
# Opcional: token inicial. Depois, o token é administrado pela tela Configurações.
IG_ACCESS_TOKEN=
# Versão da Graph API.
GRAPH_VERSION=v25.0

# ─── Rotinas agendadas ───────────────────────────────────────────────
# A Vercel envia este valor ao executar a renovação semanal do token.
CRON_SECRET=

# Endereço público do sistema (usado nos links curtos dos PDFs).
PUBLIC_BASE_URL=https://instagram.bracerumpark.com.br
